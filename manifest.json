{
  "manifest_version": 3,
  "name": "Chrome Audio Compressor",
  "version": "1.1.0",
  "description": "Mejora el audio de la pestaña activa en tiempo real: reducción de ruido, ecualizador de 3 bandas, compresor nivelador de dinámica y paneo estéreo.",
  "permissions": ["tabCapture", "offscreen", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chrome Audio Compressor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
